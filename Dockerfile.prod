# 生产镜像（docker compose 自托管用，部署在大陆 CVM）。
ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:${RUBY_VERSION}-slim-bookworm

# 国内 apt 源加速（deb.debian.org → 清华镜像），避免 CVM 上装依赖卡顿
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list; \
    fi
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git pkg-config libyaml-dev libpq-dev \
      ca-certificates curl \
    && rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH="/usr/local/bundle"

# 先装依赖，利于镜像层缓存。
COPY Gemfile Gemfile.lock ./
# 国内 gem 下载加速（源仍是 rubygems.org，只是改走镜像下载）
RUN bundle config set mirror.https://rubygems.org https://mirrors.tuna.tsinghua.edu.cn/rubygems
RUN bundle install

COPY . .

# 预编译静态资源（占位密钥与数据库地址只用于编译期，不会入库）。
RUN SECRET_KEY_BASE_DUMMY=1 \
    DATABASE_URL=postgres://dummy:dummy@127.0.0.1/dummy \
    bundle exec rails assets:precompile

COPY bin/docker-entrypoint /usr/local/bin/docker-entrypoint
RUN chmod 755 /usr/local/bin/docker-entrypoint

# 用非 root 用户运行。
RUN useradd --create-home --shell /bin/bash rails && \
    chown -R rails:rails /rails
USER rails

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
CMD ["puma", "-C", "config/puma.rb"]
