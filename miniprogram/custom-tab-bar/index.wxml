<view class="tab-bar">
  <view wx:for="{{list}}" wx:key="pagePath"
        class="tab-item {{selected === index ? 'active' : ''}}"
        style="{{selected === index ? 'background: ' + item.bg : ''}}"
        data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
    <view class="tab-text" style="{{selected === index ? 'color: ' + item.color : ''}}">{{item.text}}</view>
  </view>
</view>
