.page { padding: 24rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.primary { background: #0f766e; color: #fff; border-radius: 12rpx; margin-top: 24rpx; }
.primary::after { border: none; }
.tip { color: #94a3b8; text-align: center; padding: 80rpx 0; }
.row { display: flex; flex-direction: column; margin-bottom: 24rpx; }
