/* ===== 设计系统（复刻原网页 Tailwind 风格）===== */

page {
  background: #f4f1ec;      /* canvas */
  color: #1c1917;           /* stone-900 */
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.page {
  padding: 32rpx;
  padding-bottom: 240rpx;   /* 给底部 tabBar 留空间 */
  box-sizing: border-box;
}

/* 卡片：白色纸面 + 大圆角 */
.card {
  background: #ffffff;
  border-radius: 44rpx;
  padding: 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(28, 25, 23, 0.04);
  box-sizing: border-box;
}

/* ===== Hero 渐变横幅 ===== */
.hero {
  position: relative;
  margin: -32rpx -32rpx 40rpx;
  padding: 48rpx 40rpx 52rpx;
  border-radius: 0 0 64rpx 64rpx;
  color: #fff;
  overflow: hidden;
}
.hero::before,
.hero::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.hero::before { width: 320rpx; height: 320rpx; right: -80rpx; top: -100rpx; }
.hero::after  { width: 260rpx; height: 260rpx; left: -64rpx; bottom: -140rpx; }

.hero-indices { background: linear-gradient(135deg, #4f46e5, #3b82f6, #22d3ee); }
.hero-record  { background: linear-gradient(135deg, #7c3aed, #d946ef, #ec4899); }
.hero-groups  { background: linear-gradient(135deg, #f43f5e, #f97316, #fbbf24); }
.hero-me      { background: linear-gradient(135deg, #059669, #14b8a6, #06b6d4); }

.hero-inner { position: relative; z-index: 1; }
.hero-eyebrow { font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; opacity: 0.8; }
.hero-title-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 4rpx; }
.hero-title { font-size: 56rpx; font-weight: 800; line-height: 1.1; }
.hero-subtitle { font-size: 28rpx; opacity: 0.85; margin-top: 8rpx; line-height: 1.5; }
.hero-body { margin-top: 28rpx; }

/* 图标块（圆角彩色方块） */
.tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  font-size: 44rpx;
  line-height: 1;
}
.tile-sm { width: 72rpx; height: 72rpx; border-radius: 26rpx; font-size: 36rpx; }
.tile-lg { width: 108rpx; height: 108rpx; border-radius: 36rpx; font-size: 56rpx; }
.tile-icon { width: 60%; height: 60%; }

/* 药丸 / 标签 */
.pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
}

/* 偏离刻度条 */
.meter { position: relative; height: 22rpx; }
.meter-track {
  position: absolute; left: 0; right: 0; top: 50%;
  height: 12rpx; transform: translateY(-50%);
  border-radius: 999rpx; opacity: 0.35;
  background: linear-gradient(90deg, rgb(139,124,199), rgb(217,119,6), rgb(220,90,90), rgb(153,27,27), rgb(127,29,29));
}
.meter-dot {
  position: absolute; top: 50%;
  width: 30rpx; height: 30rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.2);
}

/* 区块标题 */
.section-title { font-size: 32rpx; font-weight: 700; color: #1c1917; }

/* 输入框 */
.field {
  background: #fff;
  border: 2rpx solid #e7e5e4;
  border-radius: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}
.field:focus { border-color: #a78bfa; }

/* 按钮 */
.btn {
  background: linear-gradient(135deg, #7c3aed, #c026d3);
  color: #fff;
  border-radius: 26rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(91, 33, 182, 0.25), 0 16rpx 40rpx -16rpx rgba(192, 38, 211, 0.6);
}
.btn::after { border: none; }

/* 列表行 */
.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
}

/* 辅助 */
.tip { color: #a8a29e; text-align: center; padding: 80rpx 0; font-size: 28rpx; }
.chevron { color: #d6d3d1; font-size: 32rpx; }
