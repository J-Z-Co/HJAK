<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <block wx:else>
    <!-- Hero -->
    <view class="hero hero-groups">
      <view class="hero-inner">
        <view class="hero-title">{{group.name}}</view>
        <view class="hero-subtitle">代号 {{group.public_id}} · {{group.member_count}} 人 · {{group.role === 'owner' ? '群主' : '成员'}}</view>
      </view>
    </view>

    <!-- 榜单切换 -->
    <view class="board-tabs">
      <view wx:for="{{boards}}" wx:key="key"
            class="board-tab {{board === item.key ? 'active' : ''}}"
            data-key="{{item.key}}" bindtap="switchBoard">{{item.label}}</view>
    </view>

    <!-- 榜单行 -->
    <view class="card list-group">
      <view wx:for="{{rows}}" wx:key="user.id" class="list-row board-row">
        <view class="rank {{item.rank === 1 ? 'rank-1' : ''}}">{{item.rankText}}</view>
        <view class="member-avatar">{{item.initial}}</view>
        <view class="member-info">
          <view class="member-name">{{item.user.display_name}}</view>
          <view class="member-note">{{item.note || ''}}</view>
        </view>
        <view class="member-right">
          <view class="member-value">{{item.value_text}}</view>
          <view class="member-streak">连续 {{item.streak}} 天</view>
        </view>
        <view wx:if="{{item.nudgeable && !item.nudged_today}}" class="nudge-btn"
              data-id="{{item.user.id}}" bindtap="nudge">提醒</view>
      </view>
    </view>

    <button class="logout" bindtap="leave">退出群组</button>
  </block>
</view>
