<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <block wx:else>
    <view class="card">
      <view class="gname">{{group.name}}</view>
      <view class="gcode">代号 {{group.public_id}} · {{group.member_count}} 人 · {{group.role === 'owner' ? '群主' : '成员'}}</view>
    </view>

    <view class="tabs">
      <view class="tab {{board === item.key ? 'active' : ''}}"
            wx:for="{{boards}}" wx:key="key"
            data-key="{{item.key}}" bindtap="switchBoard">{{item.label}}</view>
    </view>

    <view class="card rank-row" wx:for="{{rows}}" wx:key="_key">
      <view class="rank">{{item.rank || '—'}}</view>
      <view class="info">
        <view class="uname">{{item.user.display_name}}</view>
        <view class="vtext">{{item.value_text}} <text class="note">{{item.note}}</text></view>
        <view class="streak">连续 {{item.streak}} 天 · 被催 {{item.nudge_count}} 次</view>
      </view>
      <button wx:if="{{item.nudgeable && !item.nudged_today}}" size="mini"
              data-id="{{item.user.id}}" bindtap="nudge">提醒</button>
    </view>

    <button class="logout" bindtap="leave">退出群组</button>
  </block>
</view>
