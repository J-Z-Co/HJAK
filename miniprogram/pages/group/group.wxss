.board-tabs {
  display: flex;
  background: #fff;
  border-radius: 30rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.board-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  color: #78716c;
  font-size: 26rpx;
}
.board-tab.active {
  color: #ea580c;
  font-weight: 700;
  box-shadow: inset 0 -6rpx 0 #ea580c;
}

.list-group { padding: 0; }
.board-row { border-bottom: 2rpx solid #f5f5f4; align-items: center; }
.board-row:last-child { border-bottom: none; }

.rank { width: 56rpx; font-size: 34rpx; font-weight: 800; color: #1c1917; flex-shrink: 0; }
.rank-1 { color: #f59e0b; }
.member-avatar {
  width: 76rpx; height: 76rpx; border-radius: 26rpx;
  background: linear-gradient(135deg, #fb7185, #fbbf24);
  color: #fff; font-size: 34rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.member-info { flex: 1; min-width: 0; }
.member-name { font-size: 28rpx; font-weight: 700; }
.member-note { font-size: 22rpx; color: #a8a29e; margin-top: 4rpx; }
.member-right { text-align: right; flex-shrink: 0; }
.member-value { font-size: 30rpx; font-weight: 800; color: #1c1917; }
.member-streak { font-size: 22rpx; color: #a8a29e; margin-top: 4rpx; }
.nudge-btn {
  flex-shrink: 0;
  background: #ffedd5; color: #ea580c;
  border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 22rpx; font-weight: 700;
}

.logout {
  background: #fff; color: #dc2626;
  border-radius: 26rpx; font-size: 30rpx; font-weight: 700;
  padding: 24rpx; margin-top: 32rpx; text-align: center;
}
.logout::after { border: none; }
