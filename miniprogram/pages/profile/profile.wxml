<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <block wx:else>
    <!-- Hero -->
    <view class="hero hero-me">
      <view class="hero-inner">
        <view class="hero-eyebrow">我</view>
        <view class="hero-title-row">
          <view class="hero-title">{{user.display_name}}</view>
          <view class="avatar">{{avatar}}</view>
        </view>
        <view class="hero-stats">
          <view class="stat">
            <view class="stat-num">{{progress.streak}}</view>
            <view class="stat-label">连续天数</view>
          </view>
          <view class="stat">
            <view class="stat-num">{{progress.best_streak}}</view>
            <view class="stat-label">最长连续</view>
          </view>
          <view class="stat">
            <view class="stat-num">{{progress.earned_count}}/{{progress.badges.length}}</view>
            <view class="stat-label">徽章</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 提示 -->
    <view wx:if="{{warning}}" class="warn">⚠️ 填写性别和出生日期后才能计算需要它们的指数</view>

    <!-- 徽章 -->
    <view class="section-head">
      <view class="section-title">徽章</view>
      <view class="section-sub">只奖励坚持记录，不比健康结果</view>
    </view>
    <view class="badge-grid">
      <view wx:for="{{badges}}" wx:key="key" class="badge">
        <view class="badge-icon" style="background: {{item.earned ? 'linear-gradient(135deg, #fcd34d, #fb923c, #ec4899)' : '#f5f5f4'}};">{{item.earned ? item.icon : '🔒'}}</view>
        <view class="badge-title {{item.earned ? '' : 'dim'}}">{{item.title}}</view>
        <view class="badge-hint">{{item.hint}}</view>
      </view>
    </view>

    <!-- 资料 -->
    <view class="section-head"><view class="section-title">资料</view></view>
    <view class="card form">
      <view class="field-label">显示名</view>
      <input style="height: 50rpx; display: block; box-sizing: border-box" class="field" value="{{form.display_name}}" bindinput="onName" />
      <view class="field-label">性别</view>
      <radio-group bindchange="onSex" class="sex-group">
        <label><radio value="male" checked="{{form.sex === 'male'}}" color="#059669" />男</label>
        <label><radio value="female" checked="{{form.sex === 'female'}}" color="#059669" />女</label>
      </radio-group>
      <view class="field-label">出生日期</view>
      <picker mode="date" value="{{form.birth_date}}" start="1900-01-01" end="2030-12-31" bindchange="onBirth">
        <view class="field picker">{{form.birth_date || '未填写'}}</view>
      </picker>
      <button class="btn" bindtap="save">保存资料</button>
    </view>

    <!-- 建议 -->
    <view class="section-head"><view class="section-title">记录</view></view>
    <view class="card list-group">
      <view class="list-row" bindtap="goSuggestions">
        <view class="list-left"><text class="tile tile-sm list-icon">💡</text>改善建议</view>
        <view class="chevron">›</view>
      </view>
    </view>

    <!-- 退出 -->
    <button class="logout" bindtap="logout">退出登录</button>
  </block>
</view>
