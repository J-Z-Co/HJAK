.avatar {
  flex-shrink: 0;
  width: 120rpx; height: 120rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; font-weight: 800;
}

.hero-stats { margin-top: 28rpx; display: flex; gap: 16rpx; }
.stat {
  flex: 1;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 20rpx;
  text-align: center;
}
.stat-num { font-size: 44rpx; font-weight: 800; line-height: 1; }
.stat-label { font-size: 20rpx; font-weight: 600; opacity: 0.85; margin-top: 8rpx; }

.warn {
  background: #fef3c7; color: #78350f;
  border-radius: 28rpx; padding: 24rpx 28rpx;
  font-size: 26rpx; line-height: 1.6; margin-bottom: 24rpx;
}

.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin: 40rpx 0 20rpx; }
.section-sub { font-size: 22rpx; color: #78716c; }

.badge-grid { display: flex; flex-wrap: wrap; }
.badge {
  width: 31%; margin: 0 1.16% 20rpx;
  background: #fff; border-radius: 30rpx;
  padding: 20rpx 12rpx; text-align: center;
  box-sizing: border-box;
}
.badge-icon {
  width: 88rpx; height: 88rpx; margin: 0 auto;
  border-radius: 30rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.badge-title { font-size: 26rpx; font-weight: 700; margin-top: 16rpx; }
.badge-title.dim { color: #a8a29e; }
.badge-hint { font-size: 20rpx; color: #78716c; line-height: 1.4; margin-top: 6rpx; }

.form { display: flex; flex-direction: column; }
.field-label { font-size: 26rpx; font-weight: 600; color: #57534e; margin: 20rpx 0 12rpx; }
.field-label:first-child { margin-top: 0; }
.sex-group { margin-bottom: 4rpx; }
.sex-group label { margin-right: 40rpx; }
.picker { color: #1c1917; }
.form .btn { margin-top: 28rpx; }

.list-group { padding: 0; }
.list-left { display: flex; align-items: center; gap: 20rpx; font-size: 30rpx; font-weight: 600; }
.list-icon { background: #fef3c7; }

.logout {
  background: #fff; color: #dc2626;
  border-radius: 26rpx; font-size: 32rpx; font-weight: 700;
  padding: 24rpx; margin-top: 40rpx; text-align: center;
}
.logout::after { border: none; }
