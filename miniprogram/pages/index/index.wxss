.hero-score { text-align: right; flex-shrink: 0; }
.hero-score-num { font-size: 76rpx; font-weight: 800; line-height: 1; }
.hero-score-label { font-size: 22rpx; font-weight: 600; opacity: 0.85; margin-top: 8rpx; }
.hero-meter { margin-top: 28rpx; }
.hero-meter-track { background: rgba(255, 255, 255, 0.25); opacity: 1; }

.brief-card { display: flex; gap: 24rpx; align-items: flex-start; margin-bottom: 24rpx; }
.brief-icon { background: linear-gradient(135deg, #6366f1, #22d3ee); }
.brief-lines { flex: 1; min-width: 0; }
.brief-lead { font-size: 30rpx; font-weight: 700; color: #1c1917; line-height: 1.6; }
.brief-sub { font-size: 26rpx; color: #57534e; line-height: 1.6; margin-top: 8rpx; }

.section { margin-top: 48rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-pill { background: #e7e5e4; color: #57534e; }
.section-note { margin-top: 16rpx; color: #78716c; font-size: 26rpx; line-height: 1.6; }
.section-aside { margin-top: 16rpx; padding: 0 8rpx; color: #78716c; font-size: 26rpx; }

.reading-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 20rpx; }
.reading { position: relative; }
.reading.tappable { transition: transform 0.1s; }
.reading.tappable:active { transform: scale(0.99); }
.reading-main { display: flex; align-items: center; gap: 24rpx; }
.reading-info { flex: 1; min-width: 0; }
.reading-label { font-size: 30rpx; font-weight: 700; color: #1c1917; }
.reading-value { font-size: 40rpx; font-weight: 800; line-height: 1.3; margin-top: 4rpx; }
.reading-aside { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.reading-meter { margin-top: 24rpx; }
.reading-note { margin-top: 20rpx; color: #78716c; font-size: 26rpx; line-height: 1.6; }
.reading-stale { margin-top: 16rpx; color: #b45309; font-size: 22rpx; display: flex; align-items: center; gap: 8rpx; }
