.textarea { width: 100%; height: 160rpx; border: 1rpx solid #e2e8f0; border-radius: 8rpx; padding: 12rpx; box-sizing: border-box; margin-bottom: 16rpx; }
.s-body { color: #0f172a; font-size: 30rpx; line-height: 1.5; }
.s-meta { color: #94a3b8; font-size: 24rpx; margin-top: 8rpx; }
.votes { margin-top: 12rpx; display: flex; gap: 16rpx; }
.reply { color: #475569; font-size: 26rpx; padding: 8rpx 0 0 24rpx; border-left: 2rpx solid #e2e8f0; margin-top: 12rpx; }
