.form-card { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; font-weight: 600; color: #57534e; margin-bottom: 12rpx; }
.textarea { width: 100%; height: 160rpx; line-height: 1.5; padding: 20rpx 28rpx; margin-bottom: 20rpx; }

.empty { text-align: center; color: #78716c; font-size: 26rpx; padding: 60rpx 28rpx; border: 2rpx dashed #d6d3d1; }

.s-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.s-body { font-size: 30rpx; color: #1c1917; line-height: 1.6; }
.s-meta { font-size: 24rpx; color: #a8a29e; margin-top: 12rpx; }
.s-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.s-btn {
  background: #f5f5f4; color: #57534e;
  border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 24rpx; font-weight: 600;
}
.s-replies { margin-top: 16rpx; padding: 8rpx 0 0 20rpx; border-left: 2rpx solid #e7e5e4; }
.s-reply { font-size: 24rpx; color: #57534e; line-height: 1.6; margin-top: 8rpx; }
