<view class="page">
  <view class="card">
    <textarea class="textarea" value="{{body}}" placeholder="写下你的建议或反馈" bindinput="onBody" />
    <button class="primary" bindtap="submit">提交</button>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view class="card" wx:for="{{suggestions}}" wx:key="id">
    <view class="s-body">{{item.body}}</view>
    <view class="s-meta">{{item.author.display_name}} · 合理 {{item.reasonable_count}} · 有误 {{item.wrong_count}}</view>
    <view class="votes">
      <button size="mini" data-id="{{item.id}}" data-choice="reasonable" bindtap="vote">合理</button>
      <button size="mini" data-id="{{item.id}}" data-choice="wrong" bindtap="vote">有误</button>
    </view>
    <view class="reply" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
      {{reply.author.display_name}}：{{reply.body}}
    </view>
  </view>
</view>
