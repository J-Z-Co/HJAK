.ring-badge {
  flex-shrink: 0;
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.ring-num { font-size: 34rpx; font-weight: 800; line-height: 1; }
.ring-label { font-size: 20rpx; font-weight: 600; opacity: 0.8; margin-top: 6rpx; }
.ring-check { font-size: 48rpx; font-weight: 800; }

.hero-pills { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.hero-pill {
  display: inline-flex; align-items: center;
  border-radius: 999rpx; background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 24rpx; font-size: 26rpx; font-weight: 700;
}

.date-card { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 28rpx; }
.date-icon { background: #f5f5f4; }
.date-label { font-size: 30rpx; font-weight: 700; flex: 1; }
.date-value { color: #57534e; font-size: 30rpx; }

.row { background: #fff; border-radius: 44rpx; padding: 28rpx; margin-top: 20rpx; box-shadow: 0 1rpx 3rpx rgba(28,25,23,0.04); }
.row-head { display: flex; align-items: center; gap: 24rpx; }
.row-info { flex: 1; min-width: 0; }
.row-label { font-size: 30rpx; font-weight: 700; }
.row-unit { font-size: 22rpx; color: #a8a29e; margin-left: 8rpx; font-weight: 400; }
.row-caption { font-size: 22rpx; color: #78716c; margin-top: 4rpx; }
.row-inputs { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; }
.row-field { flex: 1; font-size: 34rpx; font-weight: 600; }
.slash { color: #d6d3d1; font-size: 34rpx; }
.row-error { color: #dc2626; font-size: 24rpx; margin-top: 16rpx; }

.early { margin-top: 20rpx; }
.early-head {
  display: flex; align-items: center; justify-content: space-between;
  border: 2rpx dashed #c4b5fd; border-radius: 44rpx;
  background: #f5f3ff; padding: 24rpx 28rpx;
  font-size: 26rpx; font-weight: 600; color: #6d28d9;
}
.early-toggle { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; font-weight: 500; }
.early-body { margin-top: 20rpx; }

.save-bar {
  position: sticky; bottom: 0;
  margin: 32rpx -32rpx -32rpx;
  padding: 20rpx 32rpx 32rpx;
  background: linear-gradient(to top, #f4f1ec 60%, rgba(244,241,236,0));
}
