.hero-actions { margin-top: 28rpx; display: flex; gap: 20rpx; }
.hero-btn {
  flex: 1; min-height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 30rpx; font-size: 30rpx; font-weight: 700;
}
.hero-btn-solid { background: #fff; color: #ea580c; }
.hero-btn-ghost { background: rgba(255, 255, 255, 0.2); }

.form-card { margin-bottom: 24rpx; }
.form-card .field { margin-bottom: 20rpx; }

.list-group { padding: 0; margin-top: 24rpx; }
.group-row { border-bottom: 2rpx solid #f5f5f4; }
.group-row:last-child { border-bottom: none; }
.group-avatar {
  width: 88rpx; height: 88rpx; border-radius: 30rpx;
  background: linear-gradient(135deg, #fb7185, #fbbf24);
  color: #fff; font-size: 40rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.group-info { flex: 1; min-width: 0; }
.group-name { font-size: 30rpx; font-weight: 700; }
.group-meta { font-size: 24rpx; color: #78716c; margin-top: 4rpx; }

.empty { text-align: center; padding: 60rpx 28rpx; margin-top: 24rpx; }
.empty-icon { margin: 0 auto; background: #ffedd5; }
.empty-title { font-size: 30rpx; font-weight: 700; margin-top: 24rpx; }
.empty-sub { font-size: 26rpx; color: #78716c; margin-top: 8rpx; }
