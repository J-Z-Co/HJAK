.hero-back { font-size: 26rpx; opacity: 0.9; margin-bottom: 8rpx; }
.hero-value { font-size: 64rpx; font-weight: 800; line-height: 1.1; margin-top: 8rpx; }
.hero-meter { margin-top: 28rpx; }
.hero-meter-track { background: rgba(255, 255, 255, 0.25); opacity: 1; }

.warn {
  background: #fef3c7; color: #78350f;
  border-radius: 28rpx; padding: 20rpx 28rpx;
  font-size: 24rpx; margin-bottom: 20rpx;
}

.segmented { display: flex; background: #fff; border-radius: 30rpx; padding: 8rpx; margin-bottom: 20rpx; }
.segment {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 26rpx; color: #78716c; border-radius: 24rpx;
}
.segment.active { background: #e0e7ff; color: #4f46e5; font-weight: 700; }

.chart-card { padding: 20rpx; }
.chart { width: 100%; height: 360rpx; }
.chart-empty { text-align: center; color: #78716c; font-size: 26rpx; padding: 80rpx 0; }

.legend { display: flex; gap: 32rpx; margin-top: 12rpx; padding: 0 8rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #78716c; }
.legend-swatch { width: 20rpx; height: 20rpx; border-radius: 6rpx; }

.explanation { margin-top: 28rpx; padding: 0 8rpx; color: #57534e; font-size: 26rpx; line-height: 1.7; }
