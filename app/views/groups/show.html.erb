<%= back_link "返回群组", groups_path %>
<div class="mt-1 flex items-center justify-between gap-3">
  <h1 class="min-w-0 truncate text-[1.75rem] font-bold leading-tight tracking-tight"><%= @group.name %></h1>
  <%= link_to share_group_path(@group), class: "btn-secondary w-auto shrink-0 px-4" do %>
    <%= icon(:qr, size: "size-5") %>分享
  <% end %>
</div>
<p class="mt-1 text-sm text-stone-500"><%= @rows.size %> 人 · 综合分越小越接近健康区</p>

<div class="list-group surface mt-4">
  <% @rows.each do |row| %>
    <%= link_to group_member_indices_path(@group, row.user), class: "list-row", data: { testid: "member-link-#{row.user.id}" } do %>
      <span class="flex min-w-0 items-center gap-3">
        <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border-[3px] bg-white text-base font-semibold <%= rank_ring(row.rank) %>"><%= row.rank || "—" %></span>
        <span class="min-w-0">
          <span class="block truncate font-medium"><%= row.user.display_name %><%= "（我）" if row.user == current_user %></span>
          <span class="block text-sm text-stone-500"><%= row.basis %></span>
        </span>
      </span>
      <span class="flex shrink-0 items-center gap-1">
        <% if row.score %>
          <span class="text-lg font-semibold tabular-nums" style="color: <%= ::Indices::Palette.css(row.score) %>"><%= format("%.2f", row.score) %></span>
        <% else %>
          <span class="text-sm text-stone-400">不排名</span>
        <% end %>
        <%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
      </span>
    <% end %>
  <% end %>
</div>

<section class="mt-10">
  <h2 class="eyebrow px-1"><%= @membership.owner? ? "管理" : "成员" %></h2>
  <div class="mt-2 flex flex-col gap-2.5">
    <% if @membership.owner? %>
      <% others = @group.memberships.includes(:user).where.not(user: current_user) %>
      <% if others.any? %>
        <div class="list-group">
          <% others.each do |membership| %>
            <div class="flex min-h-13 items-center justify-between gap-3 px-4 py-2">
              <span class="min-w-0 truncate"><%= membership.user.display_name %></span>
              <%= button_to "移除", group_membership_path(@group.public_id, user_id: membership.user_id), method: :delete, aria: { label: "移除#{membership.user.display_name}" }, class: "min-h-11 shrink-0 rounded-lg px-3 text-sm font-medium text-red-700 hover:bg-red-50 active:bg-red-100", form: { data: { turbo_confirm: "把#{membership.user.display_name}移出群组？" } } %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <% if @membership.owner? && @group.memberships.many? %>
      <p class="px-1 text-sm text-stone-500">群里还有别人，群主不能退出。可以移除其他成员，或删除整个群组。</p>
    <% else %>
      <%= button_to "退出群组", group_membership_path(@group.public_id), method: :delete, class: "btn-danger" %>
    <% end %>
    <% if @membership.owner? %>
      <%= button_to "删除群组", group_path(@group), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "删除后成员都会离开这个群组" } } %>
    <% end %>
  </div>
</section>
