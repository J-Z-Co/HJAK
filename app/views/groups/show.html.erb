<%= link_to "返回群组", groups_path, class: "text-sm underline-offset-4 hover:underline" %>
<h1 class="mt-3 text-2xl font-semibold"><%= @group.name %></h1>
<div class="mt-4 flex flex-col gap-3">
  <%= link_to "分享", share_group_path(@group), class: "btn-secondary" %>
</div>
<div class="mt-6 flex flex-col gap-3">
  <% @rows.each do |row| %>
    <%= link_to group_member_indices_path(@group, row.user), class: "surface flex items-center gap-3 rounded-lg border border-stone-200 bg-white px-3 py-3 hover:bg-stone-100 active:bg-stone-200", data: { testid: "member-link-#{row.user.id}" } do %>
      <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border-2 text-sm <%= rank_ring(row.rank) %>"><%= row.rank || "—" %></span>
      <span class="min-w-0">
        <span class="block font-medium"><%= row.user.display_name %></span>
        <span class="block text-sm text-stone-600"><%= row.score ? format("%.2f", row.score) : "不排名" %> · <%= row.basis %></span>
      </span>
    <% end %>
  <% end %>
</div>
<div class="mt-6 flex flex-col gap-3">
  <% if @membership.owner? && @group.memberships.many? %>
    <p class="text-sm text-stone-600">群里还有别人，群主不能退出。可以移除其他成员，或删除整个群组。</p>
  <% else %>
    <%= button_to "退出群组", group_membership_path(@group.public_id), method: :delete, class: "btn-secondary" %>
  <% end %>
  <% if @membership.owner? %>
    <% @group.memberships.includes(:user).where.not(user: current_user).each do |membership| %>
      <%= button_to "移除#{membership.user.display_name}", group_membership_path(@group.public_id, user_id: membership.user_id), method: :delete, class: "btn-secondary" %>
    <% end %>
    <%= button_to "删除群组", group_path(@group), method: :delete, class: "btn-secondary", form: { data: { turbo_confirm: "删除后成员都会离开这个群组" } } %>
  <% end %>
</div>
