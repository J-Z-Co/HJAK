<h1 class="text-2xl font-semibold">群组</h1>
<div class="mt-4 flex flex-col gap-3">
  <%= link_to "创建群组", new_group_path, class: "btn" %>
  <%= link_to "加入群组", join_group_path, class: "btn-secondary" %>
</div>
<div class="mt-6 flex flex-col gap-3">
  <% @groups.each do |group| %>
    <%= link_to group.name, group_path(group), class: "surface block min-h-11 rounded-lg border border-stone-200 bg-white px-3 py-3 hover:bg-stone-100 active:bg-stone-200", data: { testid: "group-link-#{group.public_id}" } %>
  <% end %>
</div>
