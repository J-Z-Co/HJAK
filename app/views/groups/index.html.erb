<%= hero(title: "群组", subtitle: "和家人互相看指数，比一比谁记得最勤。") do %>
  <div class="mt-4 grid grid-cols-2 gap-2.5">
    <%= link_to new_group_path, class: "inline-flex min-h-12 items-center justify-center gap-1.5 rounded-2xl bg-white font-bold text-orange-600 shadow-sm hover:bg-orange-50 active:scale-[0.98]" do %>
      <%= icon(:plus, size: "size-5", stroke: 2.4) %>创建群组
    <% end %>
    <%= link_to join_group_path, class: "inline-flex min-h-12 items-center justify-center gap-1.5 rounded-2xl bg-white/20 font-bold backdrop-blur hover:bg-white/30 active:scale-[0.98]" do %>
      <%= icon(:qr, size: "size-5") %>加入群组
    <% end %>
  </div>
<% end %>

<div class="mb-3 flex justify-end"><%= refresh_button %></div>
<% if @groups.any? %>
  <div class="list-group surface">
    <% @groups.each do |group| %>
      <%= link_to group_path(group), class: "list-row", data: { testid: "group-link-#{group.public_id}" } do %>
        <span class="flex min-w-0 items-center gap-3">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-400 to-amber-400 text-lg font-extrabold text-white"><%= group.name.first %></span>
          <span class="min-w-0">
            <span class="block truncate font-bold"><%= group.name %></span>
            <span class="block text-sm text-stone-500"><%= group.memberships.size %> 人</span>
          </span>
        </span>
        <%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-300") %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card px-4 py-10 text-center">
    <%= icon_tile(:groups, "mx-auto bg-orange-100 text-orange-600", size: "size-14") %>
    <p class="mt-3 font-bold">还没有加入群组</p>
    <p class="mt-1 text-sm text-stone-500">创建一个，再把代号发给家人。</p>
  </div>
<% end %>
