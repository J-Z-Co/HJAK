<%= link_to "返回群组", groups_path, class: "text-sm underline-offset-4 hover:underline" %>
<h1 class="mt-3 text-2xl font-semibold">创建群组</h1>
<%= form_with model: @group, class: "mt-4 flex flex-col gap-3" do |form| %>
  <%= form.label :name, "名称", class: "block text-sm" %>
  <%= form.text_field :name, class: "field-input", required: true, autofocus: true %>
  <% if @group.errors[:name].any? %>
    <p class="text-sm text-red-700"><%= @group.errors[:name].to_sentence %></p>
  <% end %>
  <%= form.submit "创建", class: "btn" %>
<% end %>
