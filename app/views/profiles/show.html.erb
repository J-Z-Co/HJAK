<% avatar = capture do %>
  <span class="inline-flex size-16 shrink-0 items-center justify-center rounded-3xl bg-white/25 text-3xl font-extrabold backdrop-blur"><%= current_user.display_name.to_s.first %></span>
<% end %>
<%= hero(title: current_user.display_name, eyebrow: "我", subtitle: current_user.email, aside: avatar) do %>
  <div class="mt-4 grid grid-cols-3 gap-2 text-center">
    <% [ [ @progress.streak, "连续天数" ], [ @progress.best_streak, "最长连续" ], [ "#{@progress.earned_count}/#{@progress.badges.size}", "徽章" ] ].each do |value, label| %>
      <div class="rounded-2xl bg-white/20 px-2 py-2.5 backdrop-blur">
        <p class="text-2xl font-extrabold leading-none"><%= value %></p>
        <p class="mt-1 text-[0.6875rem] font-semibold text-white/85"><%= label %></p>
      </div>
    <% end %>
  </div>
<% end %>

<section class="card surface mb-4 px-4 py-3 text-sm leading-6 text-stone-700" data-controller="install-hint">
  <p class="font-bold text-stone-900">放到主屏幕</p>
  <p class="hidden" data-install-hint-target="ios">在 Safari 点分享，再点「添加到主屏幕」。</p>
  <p class="hidden" data-install-hint-target="android">在浏览器菜单里点「添加到主屏幕」或「安装应用」。</p>
</section>

<% if current_user.sex.blank? || current_user.birth_date.blank? %>
  <p class="flash mb-4 bg-amber-100 text-amber-900"><%= icon(:warning, size: "size-5", stroke: 2, css: "mt-px text-amber-600") %><span>填写后才能计算需要它们的指数</span></p>
<% end %>

<div class="flex items-center justify-between">
  <h2 class="section-title">徽章</h2>
  <span class="text-xs font-semibold text-stone-500">只奖励坚持记录，不比健康结果</span>
</div>
<div class="mt-2.5 grid grid-cols-3 gap-2.5">
  <% @progress.badges.each do |badge| %>
    <div class="card flex flex-col items-center px-2 py-3 text-center <%= badge.earned ? "surface" : "border-dashed bg-transparent" %>" data-testid="badge-<%= badge.key %>">
      <% if badge.earned %>
        <%= icon_tile(badge.icon, "bg-gradient-to-br from-amber-300 via-orange-400 to-pink-500 text-white shadow-[0_6px_14px_-6px_rgba(249,115,22,0.8)]", size: "size-12") %>
      <% else %>
        <%= icon_tile(:lock, "bg-stone-100 text-stone-400", size: "size-12") %>
      <% end %>
      <p class="mt-2 text-sm font-bold <%= "text-stone-400" unless badge.earned %>"><%= badge.title %></p>
      <p class="mt-0.5 text-[0.6875rem] leading-4 text-stone-500"><%= badge.hint %></p>
    </div>
  <% end %>
</div>

<h2 class="section-title mt-8">资料</h2>
<%= form_with model: current_user, url: me_path, method: :patch, data: { turbo: false }, class: "card surface mt-2.5 flex flex-col gap-4" do |form| %>
  <div>
    <%= form.label :display_name, "显示名", class: "field-label" %>
    <%= form.text_field :display_name, class: "field-input", required: true, autocomplete: "nickname" %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :sex, "性别", class: "field-label" %>
      <%= form.select :sex, [ [ "男", "male" ], [ "女", "female" ] ], { include_blank: "未填写" }, class: "field-input" %>
    </div>
    <div>
      <%= form.label :birth_date, "出生日期", class: "field-label" %>
      <%= form.date_field :birth_date, class: "field-input", max: Time.zone.today %>
    </div>
  </div>
  <%= form.submit "保存资料", class: "btn" %>
<% end %>

<h2 class="section-title mt-8">记录</h2>
<div class="list-group surface mt-2.5">
  <%= link_to corrections_path, class: "list-row" do %>
    <span class="flex items-center gap-3 font-semibold"><%= icon_tile(:record, "bg-violet-100 text-violet-600", size: "size-9") %>纠正误输入</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-300") %>
  <% end %>
  <%= link_to suggestions_path, class: "list-row" do %>
    <span class="flex items-center gap-3 font-semibold"><%= icon_tile(:sparkles, "bg-amber-100 text-amber-600", size: "size-9") %>改善建议</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-300") %>
  <% end %>
</div>

<h2 class="section-title mt-8">账号</h2>
<div class="list-group surface mt-2.5">
  <%= link_to edit_user_registration_path, class: "list-row" do %>
    <span class="flex items-center gap-3 font-semibold"><%= icon_tile(:lock, "bg-sky-100 text-sky-600", size: "size-9") %>修改密码</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-300") %>
  <% end %>
  <%= button_to "退出登录", destroy_user_session_path, method: :delete, class: "list-row justify-center font-bold text-red-600", data: { testid: "sign-out" } %>
</div>
