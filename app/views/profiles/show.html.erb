<div class="flex items-center gap-4">
  <span class="inline-flex size-16 shrink-0 items-center justify-center rounded-full bg-accent-soft text-2xl font-semibold text-accent"><%= current_user.display_name.to_s.first %></span>
  <div class="min-w-0">
    <h1 class="truncate text-[1.75rem] font-bold leading-tight tracking-tight">我</h1>
    <p class="truncate text-sm text-stone-500"><%= current_user.email %></p>
  </div>
</div>
<% if current_user.sex.blank? || current_user.birth_date.blank? %>
  <p class="flash mt-4 bg-[#FEF9C3] text-amber-950"><%= icon(:warning, size: "size-5", stroke: 2, css: "mt-px text-amber-700") %><span>填写后才能计算需要它们的指数</span></p>
<% end %>

<h2 class="eyebrow mt-6 px-1">资料</h2>
<%= form_with model: current_user, url: me_path, method: :patch, data: { turbo: false }, class: "card surface mt-2 flex flex-col gap-4" do |form| %>
  <div>
    <%= form.label :display_name, "显示名", class: "field-label" %>
    <%= form.text_field :display_name, class: "field-input", required: true, autocomplete: "nickname" %>
  </div>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= form.label :sex, "性别", class: "field-label" %>
      <%= form.select :sex, [ [ "男", "male" ], [ "女", "female" ] ], { include_blank: "未填写" }, class: "field-input" %>
    </div>
    <div>
      <%= form.label :birth_date, "出生日期", class: "field-label" %>
      <%= form.date_field :birth_date, class: "field-input", max: Time.zone.today %>
    </div>
  </div>
  <%= form.submit "保存资料", class: "btn" %>
<% end %>

<h2 class="eyebrow mt-8 px-1">记录</h2>
<div class="list-group surface mt-2">
  <%= link_to corrections_path, class: "list-row" do %>
    <span>纠正误输入</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
  <% end %>
  <%= link_to suggestions_path, class: "list-row" do %>
    <span>改善建议</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
  <% end %>
</div>

<h2 class="eyebrow mt-8 px-1">账号</h2>
<div class="list-group surface mt-2">
  <%= link_to edit_user_registration_path, class: "list-row" do %>
    <span>修改密码</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
  <% end %>
  <%= button_to "退出登录", destroy_user_session_path, method: :delete, class: "list-row justify-center font-medium text-red-700", data: { testid: "sign-out" } %>
</div>
