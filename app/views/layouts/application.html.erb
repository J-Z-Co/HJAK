<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title><%= content_for(:title) || "Phoenix List" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Phoenix List">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-stone-900 antialiased">
    <div class="mx-auto min-h-dvh w-full max-w-lg bg-paper sm:shadow-[0_0_0_1px_rgba(28,25,23,0.04),0_8px_40px_-12px_rgba(28,25,23,0.12)]">
      <main class="px-4 pt-[max(1.25rem,env(safe-area-inset-top))] <%= user_signed_in? && !devise_controller? ? "pb-28" : "pb-10" %>">
        <% if notice.present? %>
          <p class="flash surface mb-4 bg-[#DCFCE7] text-green-950" role="status"><%= icon(:check, size: "size-5", stroke: 2, css: "mt-px text-green-700") %><span><%= notice %></span></p>
        <% end %>
        <% if alert.present? %>
          <p class="flash surface mb-4 bg-[#FEF9C3] text-amber-950" role="alert"><%= icon(:warning, size: "size-5", stroke: 2, css: "mt-px text-amber-700") %><span><%= alert %></span></p>
        <% end %>
        <%= yield %>
      </main>
      <%= render "layouts/tab_bar" if user_signed_in? && !devise_controller? %>
    </div>
  </body>
</html>
