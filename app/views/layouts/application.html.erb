<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <title><%= content_for(:title) || "Phoenix List" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="turbo-prefetch" content="false">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="合家康">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="合家安康">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f4f1ec">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <% if @phoenix_etag %>
      <meta name="phoenix-etag" content="<%= @phoenix_etag %>">
    <% end %>
    <% if Rails.env.production? %>
      <meta name="phoenix-revalidate" content="1">
      <script>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register("/service-worker")
      </script>
    <% end %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-canvas text-stone-900 antialiased" <% if Rails.env.production? %>data-controller="revalidate"<% end %>>
    <div class="mx-auto min-h-dvh w-full max-w-lg bg-paper sm:shadow-[0_0_0_1px_rgba(28,25,23,0.04),0_8px_40px_-12px_rgba(28,25,23,0.12)]">
      <main class="px-4 pt-[max(1.25rem,env(safe-area-inset-top))] <%= user_signed_in? && !devise_controller? ? "pb-28" : "pb-10" %>">
        <% if notice.present? || alert.present? %>
          <div class="pointer-events-none fixed inset-x-0 top-[max(0.75rem,env(safe-area-inset-top))] z-40 mx-auto w-full max-w-lg px-4" data-controller="toast">
            <% if notice.present? %>
              <p class="flash pointer-events-auto bg-stone-900/95 text-white shadow-lg backdrop-blur" role="status"><%= icon(:check, size: "size-5", stroke: 2.4, css: "mt-px text-green-400") %><span><%= notice %></span></p>
            <% end %>
            <% if alert.present? %>
              <p class="flash pointer-events-auto mt-2 bg-amber-300 text-amber-950 shadow-lg" role="alert"><%= icon(:warning, size: "size-5", stroke: 2, css: "mt-px") %><span><%= alert %></span></p>
            <% end %>
          </div>
        <% end %>
        <div id="phoenix-page">
          <%= yield %>
        </div>
      </main>
      <%= render "layouts/tab_bar" if user_signed_in? && !devise_controller? %>
    </div>
  </body>
</html>
