<%= hero(title: "加入群组", back: [ "返回群组", groups_path ], subtitle: "加入后，同组成员能看到你的指数、图表，以及时效内、时效外或未点亮。") %>

<% if @group %>
  <section class="card surface text-center">
    <span class="mx-auto inline-flex size-14 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-400 to-amber-400 text-2xl font-extrabold text-white"><%= @group.name.first %></span>
    <p class="mt-3 text-xl font-bold tracking-tight"><%= @group.name %></p>
    <p class="mt-1 font-mono text-sm tracking-widest text-stone-500"><%= @group.public_id %></p>
    <%= button_to "加入", join_group_path, method: :post, params: { code: @group.public_id }, class: "btn mt-5", data: { testid: "join-group" } %>
  </section>
<% else %>
  <div data-controller="join-scan">
    <div class="segmented" role="tablist">
      <button type="button" role="tab" aria-selected="true" class="segment" data-testid="join-by-code" data-join-scan-target="codeTab" data-action="join-scan#showCode">输入代号</button>
      <button type="button" role="tab" aria-selected="false" class="segment" data-testid="join-by-scan" data-join-scan-target="scanTab" data-action="join-scan#showScan">扫描</button>
    </div>
    <% if @error.present? %>
      <p class="flash mt-3 bg-[#FEF9C3] text-amber-950"><%= @error %></p>
    <% end %>
    <p class="flash mt-3 hidden bg-[#FEF9C3] text-amber-950" data-join-scan-target="failure">这里不能打开相机，请输入代号，或用系统相机打开分享页上的二维码</p>
    <%= form_with url: join_group_path, method: :get, data: { join_scan_target: "codePanel" }, class: "mt-4 flex flex-col gap-4" do %>
      <div>
        <label class="field-label" for="join-code">代号</label>
        <input id="join-code" name="code" value="<%= @parsed %>" class="field-input font-mono text-center text-xl tracking-[0.2em] uppercase" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABCD EFGH" enterkeyhint="go" data-join-scan-target="code">
      </div>
      <button class="btn" type="submit">查看群组</button>
    <% end %>
    <div class="mt-4 hidden" data-join-scan-target="scanPanel">
      <div id="join-reader" class="aspect-square w-full overflow-hidden rounded-[1.125rem] bg-stone-900" data-join-scan-target="reader"></div>
      <p class="mt-3 text-center text-sm text-stone-500">把分享页上的二维码放进框里</p>
    </div>
  </div>
<% end %>
