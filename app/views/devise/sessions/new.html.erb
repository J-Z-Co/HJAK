<header class="relative -mx-4 -mt-[max(1.25rem,env(safe-area-inset-top))] mb-5 overflow-hidden rounded-b-[2rem] bg-gradient-to-br from-violet-600 via-fuchsia-500 to-orange-400 px-5 pb-8 pt-[calc(env(safe-area-inset-top)+2.5rem)] text-center text-white">
  <div class="pointer-events-none absolute -right-10 -top-12 size-44 rounded-full bg-white/15" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-8 size-36 rounded-full bg-white/10" aria-hidden="true"></div>
  <div class="relative">
    <span class="mx-auto inline-flex size-16 items-center justify-center rounded-3xl bg-white/25 backdrop-blur"><%= icon(:fire, size: "size-9", stroke: 1.8) %></span>
    <p class="mt-3 text-sm font-semibold text-white/85">Phoenix List · 家庭健康指标</p>
    <h1 class="mt-1 text-[2rem] font-extrabold leading-tight tracking-tight">登录</h1>
  </div>
</header>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "card surface flex flex-col gap-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "field-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", inputmode: "email", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password, class: "field-label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "field-input", enterkeyhint: "go" %>
  </div>

  <%= f.hidden_field :remember_me, value: "1" %>

  <%= f.submit "登录", class: "btn mt-1", data: { turbo_submits_with: "登录中…" } %>
<% end %>

<div class="mt-4 flex items-center justify-between px-1">
  <%= link_to "忘记密码？", new_password_path(resource_name), class: "inline-flex min-h-11 items-center text-sm text-stone-500 hover:text-stone-900" %>
  <p class="text-sm text-stone-500">还没有账号？<%= link_to "注册", new_registration_path(resource_name), class: "inline-flex min-h-11 items-center font-bold text-violet-600" %></p>
</div>
