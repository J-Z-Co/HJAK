<div class="pt-8 text-center">
  <%= image_tag "/icon.svg", alt: "", class: "mx-auto size-16 rounded-2xl shadow-sm" %>
  <p class="mt-3 text-sm font-medium text-stone-500">Phoenix List · 家庭健康指标</p>
  <h1 class="mt-1 text-[1.75rem] font-bold leading-tight tracking-tight">登录</h1>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "card surface mt-6 flex flex-col gap-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "field-label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", inputmode: "email", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password, class: "field-label" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "field-input", enterkeyhint: "go" %>
  </div>

  <%= f.hidden_field :remember_me, value: "1" %>

  <%= f.submit "登录", class: "btn mt-1", data: { turbo_submits_with: "登录中…" } %>
<% end %>

<div class="mt-4 flex items-center justify-between px-1">
  <%= link_to "忘记密码？", new_password_path(resource_name), class: "inline-flex min-h-11 items-center text-sm text-stone-500 hover:text-stone-900" %>
  <p class="text-sm text-stone-500">还没有账号？<%= link_to "注册", new_registration_path(resource_name), class: "inline-flex min-h-11 items-center font-semibold text-accent" %></p>
</div>
