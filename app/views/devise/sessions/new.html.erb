<h1 class="text-2xl font-semibold">登录</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 flex flex-col gap-4" }) do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm" %>
    <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
  </div>

  <%= f.hidden_field :remember_me, value: "1" %>

  <%= f.submit "登录", class: "btn" %>
<% end %>

<%= link_to "注册", new_registration_path(resource_name), class: "btn-secondary mt-3" %>
<%= link_to "忘记密码？", new_password_path(resource_name), class: "mt-3 inline-flex min-h-11 items-center text-sm underline-offset-4 hover:underline" %>
