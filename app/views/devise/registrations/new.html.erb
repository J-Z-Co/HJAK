<header class="relative -mx-4 -mt-[max(1.25rem,env(safe-area-inset-top))] mb-5 overflow-hidden rounded-b-[2rem] bg-gradient-to-br from-violet-600 via-fuchsia-500 to-orange-400 px-5 pb-8 pt-[calc(env(safe-area-inset-top)+2.5rem)] text-center text-white">
  <div class="pointer-events-none absolute -right-10 -top-12 size-44 rounded-full bg-white/15" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-8 size-36 rounded-full bg-white/10" aria-hidden="true"></div>
  <div class="relative">
    <span class="mx-auto inline-flex size-16 items-center justify-center rounded-3xl bg-white/25 backdrop-blur"><%= icon(:fire, size: "size-9", stroke: 1.8) %></span>
    <p class="mt-3 text-sm font-semibold text-white/85">Phoenix List · 家庭健康指标</p>
    <h1 class="mt-1 text-[2rem] font-extrabold leading-tight tracking-tight">注册</h1>
  </div>
</header>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "card surface flex flex-col gap-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :display_name, class: "field-label" %>
    <%= f.text_field :display_name, autofocus: true, autocomplete: "nickname", required: true, class: "field-input" %>
  </div>

  <div>
    <%= f.label :email, class: "field-label" %>
    <%= f.email_field :email, autocomplete: "email", inputmode: "email", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password, class: "field-label" %>
    <% if @minimum_password_length %>
      <span class="text-xs text-stone-500">（至少 <%= @minimum_password_length %> 个字符）</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "field-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :sex, class: "field-label" %>
      <%= f.select :sex, [ [ "男", "male" ], [ "女", "female" ] ], { include_blank: "请选择" }, required: true, class: "field-input" %>
    </div>
    <div>
      <%= f.label :birth_date, class: "field-label" %>
      <%= f.date_field :birth_date, max: Time.zone.today, required: true, class: "field-input", enterkeyhint: "go" %>
    </div>
  </div>

  <%= f.submit "注册", class: "btn mt-1", data: { turbo_submits_with: "注册中…" } %>
<% end %>

<p class="mt-4 text-center text-sm text-stone-500">已经有账号？<%= link_to "登录", new_session_path(resource_name), class: "inline-flex min-h-11 items-center font-bold text-violet-600" %></p>
