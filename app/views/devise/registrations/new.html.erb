<div class="pt-8 text-center">
  <%= image_tag "/icon.svg", alt: "", class: "mx-auto size-16 rounded-2xl shadow-sm" %>
  <p class="mt-3 text-sm font-medium text-stone-500">Phoenix List · 家庭健康指标</p>
  <h1 class="mt-1 text-[1.75rem] font-bold leading-tight tracking-tight">注册</h1>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "card surface mt-6 flex flex-col gap-4" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div>
    <%= f.label :display_name, class: "field-label" %>
    <%= f.text_field :display_name, autofocus: true, autocomplete: "nickname", required: true, class: "field-input" %>
  </div>

  <div>
    <%= f.label :email, class: "field-label" %>
    <%= f.email_field :email, autocomplete: "email", inputmode: "email", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password, class: "field-label" %>
    <% if @minimum_password_length %>
      <span class="text-xs text-stone-500">（至少 <%= @minimum_password_length %> 个字符）</span>
    <% end %>
    <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "field-label" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input", enterkeyhint: "go" %>
  </div>

  <%= f.submit "注册", class: "btn mt-1", data: { turbo_submits_with: "注册中…" } %>
<% end %>

<p class="mt-4 text-center text-sm text-stone-500">已经有账号？<%= link_to "登录", new_session_path(resource_name), class: "inline-flex min-h-11 items-center font-semibold text-accent" %></p>
