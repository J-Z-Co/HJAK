<%= hero(title: "修改#{@metric.label}", back: [ "返回", correction_path(@metric.key) ], subtitle: "测量日 #{correction_date(@measurement)}。这里不改日期。") %>

<%= form_with url: correction_entry_path(@metric.key, @measurement), method: :patch, class: "card surface flex flex-col gap-4" do %>
  <div class="<%= "grid grid-cols-2 gap-3" if @metric.blood_pressure? %>">
    <div>
      <%= label_tag :value, @metric.blood_pressure? ? "收缩压" : "#{@metric.label}（#{@metric.unit}）", class: "field-label" %>
      <%= number_field_tag :value, @value, class: "field-input", inputmode: "decimal", step: @metric.blood_pressure? ? "1" : "0.1" %>
    </div>
    <% if @metric.blood_pressure? %>
      <div>
        <%= label_tag :value_secondary, "舒张压", class: "field-label" %>
        <%= number_field_tag :value_secondary, @secondary, class: "field-input", inputmode: "decimal", step: "1" %>
      </div>
    <% end %>
  </div>
  <% if @error.present? %>
    <p class="field-error mt-0"><%= @error %></p>
  <% end %>
  <%= submit_tag "保存修改", class: "btn", data: { turbo_submits_with: "保存中…" } %>
<% end %>

<%= button_to "删除这次", correction_entry_path(@metric.key, @measurement), method: :delete, class: "btn-danger mt-3", form: { data: { turbo_confirm: "删除这条记录？" } } %>
