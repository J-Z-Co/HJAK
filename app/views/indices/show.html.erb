<%= back_link chart_back_label, chart_back_path %>
<h1 class="mt-1 text-[1.75rem] font-bold leading-tight tracking-tight" style="<%= index_name_style(@reading) %>"><%= @reading.label %></h1>
<% if @reading.value_text.present? %>
  <p class="mt-1 text-xl font-semibold tracking-tight text-stone-800"><%= @reading.value_text %></p>
<% end %>
<% if @reading.stale_text.present? %>
  <p class="flash mt-3 bg-[#FEF9C3] text-amber-950"><%= @reading.stale_text %></p>
<% end %>

<nav class="segmented mt-4" aria-label="时间范围">
  <% [ [ "7d", "近 7 天" ], [ "30d", "近 1 个月" ], [ "365d", "近 1 年" ] ].each do |range, label| %>
    <%= link_to label, chart_range_path(@reading.key, range), class: "segment", aria: { current: (@series[:range] == range ? "page" : nil) }, data: { testid: "range-#{range}" } %>
  <% end %>
</nav>

<div class="card surface mt-3 px-3">
  <% if @series[:points].empty? %>
    <p class="py-10 text-center text-sm text-stone-500">这段时间还没有足够的记录</p>
  <% else %>
    <% latest_point = "最近一点 #{@series[:points].last[:text] || @series[:points].last[:value]}" %>
    <div class="w-full overflow-hidden" data-controller="index-chart" data-index-chart-payload-value="<%= @series.to_json %>">
      <p class="px-1 text-sm font-medium text-stone-700" data-index-chart-target="readout" data-latest="<%= latest_point %>"><%= latest_point %></p>
      <svg data-index-chart-target="svg" class="mt-2 block h-auto w-full max-w-full touch-manipulation" role="img" aria-label="<%= @reading.label %>走势"></svg>
    </div>
    <% if @reading.chart != :line %>
    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 px-1 text-xs text-stone-500" aria-label="色带说明">
      <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-[#EDE9FE]"></span>健康区</li>
      <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-[#FEF9C3]"></span>亚健康</li>
      <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-[#FECACA]"></span>警告区</li>
    </ul>
    <% end %>
  <% end %>
</div>
<p class="mt-4 px-1 text-sm leading-6 text-stone-600"><%= @explanation %></p>
