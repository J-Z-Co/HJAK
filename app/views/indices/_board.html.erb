<% if brief.lines.any? %>
  <div class="card surface mt-4 bg-white/70">
    <% brief.lines.each_with_index do |line, index| %>
      <p class="<%= index.zero? ? "text-[0.9375rem] font-medium text-stone-900" : "mt-1.5 text-sm text-stone-600" %> leading-6"><%= line %></p>
    <% end %>
    <% if local_assigns[:overview] %>
      <%= link_to overview_indices_path, class: "btn-secondary mt-3 justify-between" do %>
        <span>综合偏离</span><%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
      <% end %>
    <% end %>
  </div>
<% end %>

<% brief.groups.each do |group| %>
  <section class="mt-7">
    <div class="flex items-baseline justify-between gap-3 px-1">
      <h2 class="text-lg font-bold tracking-tight"><%= group.title %></h2>
      <% unless group.note %>
        <p class="text-right text-sm text-stone-500"><%= group.status %></p>
      <% end %>
    </div>
    <% if group.note %>
      <p class="card mt-2 text-sm leading-6 text-stone-600"><%= group.note %></p>
    <% else %>
      <div class="mt-2 flex flex-col gap-2.5">
        <% group.readings.each do |reading| %>
          <%= render "indices/reading", reading:, badges: local_assigns[:badges] %>
        <% end %>
      </div>
      <% if group.aside %>
        <p class="mt-2 px-1 text-sm text-stone-500"><%= group.aside %></p>
      <% end %>
    <% end %>
  </section>
<% end %>
