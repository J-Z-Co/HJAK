<% score = capture do %>
  <% if @board.mean %>
    <div class="shrink-0 text-right">
      <p class="text-[2.5rem] font-extrabold leading-none tracking-tight"><%= format("%.2f", @board.mean) %></p>
      <p class="mt-1 text-xs font-semibold text-white/85">综合偏离 · <%= deviation_word(@board.mean) %></p>
    </div>
  <% end %>
<% end %>
<%= hero(title: "指数", eyebrow: @board.basis, subtitle: @board.banner, aside: score) do %>
  <% if @board.mean %>
    <%= deviation_meter(@board.mean, track: "bg-white/25", css: "mt-4") %>
  <% end %>
<% end %>

<%= render "indices/board", brief: @brief, badges: false, overview: true %>
