<%= link_to "返回指数", indices_path, class: "text-sm underline-offset-4 hover:underline" %>
<h1 class="mt-3 text-2xl font-semibold">综合偏离</h1>

<% if !@board.compare? %>
  <p class="mt-4 text-sm text-stone-700">未满 6 岁暂不比较偏离</p>
<% elsif @board.scored.empty? %>
  <p class="mt-4 text-sm text-stone-700">还没有可以比较的指数</p>
<% else %>
  <p class="mt-3 text-sm text-stone-600">原点在健康区内。棒越长，离这个年龄的健康区越远。综合分 <%= format("%.2f", @board.mean) %>。</p>
  <div class="mt-4 flex flex-col gap-4">
    <% @board.scored.each do |reading| %>
      <div>
        <div class="flex items-baseline justify-between gap-3 text-sm">
          <span><%= reading.label %></span>
          <span><%= format("%.2f", reading.deviation) %></span>
        </div>
        <svg viewBox="0 0 100 16" class="mt-1 block h-6 w-full max-w-full" role="img" aria-label="<%= reading.label %>偏离 <%= format("%.2f", reading.deviation) %>">
          <line x1="0" y1="8" x2="<%= reading.deviation / 2.0 * 100 %>" y2="8" stroke="<%= ::Indices::Palette.css(reading.deviation) %>" stroke-width="2" />
          <circle cx="<%= reading.deviation / 2.0 * 100 %>" cy="8" r="3" fill="<%= ::Indices::Palette.css(reading.deviation) %>" />
        </svg>
      </div>
    <% end %>
  </div>
<% end %>
