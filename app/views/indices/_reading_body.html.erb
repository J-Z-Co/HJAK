<% badge = local_assigns[:badges] && freshness_badge(reading) %>
<% if reading.value_text.present? || badge %>
  <div class="mt-1.5 flex items-center justify-between gap-3">
    <p class="text-xl font-semibold tracking-tight text-stone-800"><%= reading.value_text %></p>
    <% if badge %>
      <span class="chip shrink-0 <%= freshness_badge_class(badge) %>"><%= badge %></span>
    <% end %>
  </div>
<% end %>
<% if reading.profile_fields.any? && !local_assigns[:badges] %>
  <p class="relative z-10 mt-2 flex flex-wrap gap-2 text-sm">
    <% reading.profile_fields.each do |field| %>
      <%= link_to(field == :sex ? "填写性别" : "填写出生日期", me_path, class: "chip border-dashed text-accent hover:bg-accent-soft") %>
    <% end %>
  </p>
<% end %>
<% if reading.note.present? %>
  <p class="mt-2 text-sm leading-6 text-stone-600">
    <% if reading.note_anchor %>
      <%= link_to reading.note, indices_path(anchor: "index-#{reading.note_anchor}"), class: "relative z-10 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-600" %>
    <% else %>
      <%= reading.note %>
    <% end %>
  </p>
<% end %>
<% if reading.stale_text.present? && !local_assigns[:badges] %>
  <p class="mt-2 text-sm leading-6 text-amber-800"><%= reading.stale_text %></p>
<% end %>
