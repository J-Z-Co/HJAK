<section class="card surface p-3.5 <%= record_row_ring(row) %>" data-testid="record-row-<%= row.key %>">
  <div class="flex items-center gap-3">
    <%= metric_tile(row.key) %>
    <div class="min-w-0 flex-1">
      <label class="text-base font-bold" for="measurements_<%= row.key %>_value">
        <%= row.entry.label %><span class="ml-1 text-xs font-medium text-stone-400"><%= row.entry.unit %></span>
      </label>
      <p class="truncate text-xs text-stone-500"><%= row.caption %></p>
    </div>
    <% if row.status == :never %>
      <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-500"><%= icon(:bulb, size: "size-4", label: "点亮这项记录") %>未点亮</span>
    <% else %>
      <%= status_pill(row.status) %>
    <% end %>
  </div>

  <% if row.entry.blood_pressure? %>
    <div class="mt-3 flex items-center gap-2">
      <%= number_field_tag "measurements[#{row.key}][value]", row.submitted_value, id: "measurements_#{row.key}_value", class: "field-input mt-0 text-lg font-semibold", inputmode: "decimal", step: "1", placeholder: record_placeholder(row, "收缩压"), enterkeyhint: "next", aria: { label: "收缩压" } %>
      <span class="text-xl font-light text-stone-300" aria-hidden="true">/</span>
      <%= number_field_tag "measurements[#{row.key}][value_secondary]", row.submitted_secondary, id: "measurements_#{row.key}_value_secondary", class: "field-input mt-0 text-lg font-semibold", inputmode: "decimal", step: "1", placeholder: record_placeholder(row, "舒张压", secondary: true), enterkeyhint: "next", aria: { label: "舒张压" } %>
    </div>
  <% else %>
    <%= number_field_tag "measurements[#{row.key}][value]", row.submitted_value, id: "measurements_#{row.key}_value", class: "field-input mt-3 text-lg font-semibold", inputmode: "decimal", step: "0.1", placeholder: record_placeholder(row, "本次#{row.entry.label}"), enterkeyhint: "next" %>
  <% end %>

  <% if row.error.present? %>
    <p class="field-error"><%= row.error %></p>
  <% end %>

  <% if row.history.any? %>
    <details class="group mt-2">
      <summary class="-mx-1 inline-flex min-h-9 cursor-pointer list-none items-center gap-1 rounded-lg px-1 text-xs font-semibold text-violet-600 hover:bg-violet-50 [&::-webkit-details-marker]:hidden">
        <%= icon(:chart_line, size: "size-4", stroke: 2) %>
        走势 · 最近 <%= row.history.size %> 次
        <%= icon(:chevron_right, size: "size-3.5", stroke: 2.4, css: "transition-transform group-open:rotate-90") %>
      </summary>
      <%= sparkline_tag(row) %>
    </details>
  <% end %>
</section>
