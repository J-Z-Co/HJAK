<%= back_link "返回", me_path %>
<h1 class="mt-1 text-[1.75rem] font-bold leading-tight tracking-tight">纠正误输入</h1>
<p class="mt-1 text-sm leading-6 text-stone-500">改的是已经记下的数字。日期不对时，删掉这一条，回到记录页用测量日重新记。</p>

<div class="list-group surface mt-4">
  <% Metrics::Catalog.all.each do |metric| %>
    <%= link_to correction_path(metric.key), class: "list-row" do %>
      <span><%= metric.label %> <span class="text-sm text-stone-400"><%= metric.unit %></span></span>
      <%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
    <% end %>
  <% end %>
</div>
