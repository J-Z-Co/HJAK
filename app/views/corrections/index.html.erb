<%= hero(title: "纠正误输入", back: [ "返回", me_path ], subtitle: "改的是已经记下的数字。日期不对时，删掉这一条，回到记录页用测量日重新记。") %>

<div class="list-group surface">
  <% Metrics::Catalog.all.each do |metric| %>
    <%= link_to correction_path(metric.key), class: "list-row" do %>
      <span class="flex items-center gap-3 font-semibold"><%= metric_tile(metric.key, size: "size-9") %><%= metric.label %><span class="text-xs font-medium text-stone-400"><%= metric.unit %></span></span>
      <%= icon(:chevron_right, size: "size-5", stroke: 2, css: "text-stone-400") %>
    <% end %>
  <% end %>
</div>
