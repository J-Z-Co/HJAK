<%= link_to "返回", me_path, class: "text-sm underline-offset-4 hover:underline" %>
<h1 class="mt-3 text-2xl font-semibold">纠正误输入</h1>
<p class="mt-3 text-sm leading-6 text-stone-700">改的是已经记下的数字。日期不对时，删掉这一条，回到记录页用测量日重新记。</p>

<div class="mt-4 flex flex-col gap-3">
  <% Metrics::Catalog.all.each do |metric| %>
    <%= link_to metric.label, correction_path(metric.key), class: "btn-secondary" %>
  <% end %>
</div>
