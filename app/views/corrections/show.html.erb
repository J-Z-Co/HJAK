<%= back_link "返回", corrections_path %>
<h1 class="mt-1 text-[1.75rem] font-bold leading-tight tracking-tight"><%= @metric.label %></h1>

<% if @measurements.empty? %>
  <p class="card mt-4 text-center text-sm text-stone-500">还没有这项记录</p>
<% else %>
  <p class="mt-1 text-sm text-stone-500">点一条修改数值或删除</p>
  <div class="list-group surface mt-4">
    <% @measurements.each do |measurement| %>
      <%= link_to edit_correction_entry_path(@metric.key, measurement), class: "list-row" do %>
        <span class="text-stone-600"><%= correction_date(measurement) %></span>
        <span class="flex items-center gap-1">
          <span class="font-semibold tabular-nums"><%= correction_value(measurement) %></span>
          <span class="text-sm text-stone-500"><%= @metric.unit %></span>
          <%= icon(:chevron_right, size: "size-5", stroke: 2, css: "ml-1 text-stone-400") %>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
